# GEMINI_API_KEY: Required for live Gemini AI insights, transcription, and Lyria music features.
# Leave unset or keep placeholder to run with built-in offline fallbacks.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Secret key used to sign authentication tokens (change in production).
JWT_SECRET="replace-with-a-long-random-secret"

# PORT: Server port (defaults to 3000).
PORT=3000

# APP_URL: Optional public deployment URL.
APP_URL="http://localhost:3000"
